{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks.dev/schemas/http-graph.schema.json",
  "title": "Stacks graph response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "stack", "summary", "nodes", "edges", "unresolved"],
  "properties": {
    "schemaVersion": { "const": "0.1" },
    "stack": { "type": "object", "required": ["id", "namespace", "name"] },
    "summary": {
      "type": "object", "additionalProperties": false,
      "required": ["components", "edges", "capabilities", "unresolved"],
      "properties": {
        "components": { "type": "integer", "minimum": 0 }, "edges": { "type": "integer", "minimum": 0 },
        "capabilities": { "type": "integer", "minimum": 0 }, "unresolved": { "type": "integer", "minimum": 0 }
      }
    },
    "nodes": { "type": "array", "items": { "$ref": "#/$defs/node" } },
    "edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "unresolved": { "type": "array", "items": { "$ref": "#/$defs/unresolved" } }
  },
  "$defs": {
    "node": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "name", "kind", "sourceType", "access", "provides", "consumes", "requirements", "artifacts"],
      "properties": {
        "id": { "type": "string" }, "name": { "type": "string" }, "kind": { "type": "string" },
        "description": { "type": "string" }, "sourceType": { "enum": ["path", "git", "local"] },
        "access": { "enum": ["read-only", "read-write"] },
        "provides": { "type": "array", "items": { "type": "string" } },
        "consumes": { "type": "array", "items": { "type": "string" } },
        "requirements": { "type": "array", "items": { "$ref": "#/$defs/requirement" } },
        "artifacts": { "type": "array", "items": { "$ref": "#/$defs/artifact" } }
      }
    },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["capability", "optional"],
      "properties": {
        "capability": { "type": "string" }, "from": { "type": "string" }, "optional": { "type": "boolean" }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["capability", "ecosystem", "name"],
      "properties": {
        "capability": { "type": "string" }, "ecosystem": { "type": "string" }, "name": { "type": "string" }, "path": { "type": "string" }
      }
    },
    "edge": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "from", "to", "relation", "label", "optional"],
      "properties": {
        "id": { "type": "string" }, "from": { "type": "string" }, "to": { "type": "string" },
        "relation": { "enum": ["capability", "dependency"] }, "label": { "type": "string" }, "optional": { "type": "boolean" }
      }
    },
    "unresolved": {
      "type": "object", "additionalProperties": false,
      "required": ["componentId", "capability", "optional", "reason", "candidates"],
      "properties": {
        "componentId": { "type": "string" }, "capability": { "type": "string" }, "optional": { "type": "boolean" },
        "reason": { "enum": ["missing-provider", "unknown-provider", "provider-mismatch", "ambiguous-provider"] },
        "candidates": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
