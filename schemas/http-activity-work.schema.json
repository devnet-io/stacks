{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks.dev/schemas/http-activity-work.schema.json",
  "title": "Stacks activity work detail response",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "stack", "work", "turns", "events", "eventLimit", "warnings"],
  "properties": {
    "schemaVersion": { "const": "0.1" }, "generatedAt": { "type": "string", "format": "date-time" },
    "stack": { "type": "object" }, "work": { "type": "object" }, "turns": { "type": "array" },
    "events": { "type": "array", "maxItems": 100 }, "eventLimit": { "const": 100 }, "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
