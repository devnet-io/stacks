{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stacks.dev/schemas/lock.schema.json",
  "title": "Stacks lock snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "stackId",
    "generatedAt",
    "manifestSha256",
    "components"
  ],
  "properties": {
    "schemaVersion": {
      "const": "0.1"
    },
    "stackId": {
      "type": "string"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "manifestSha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "sourceType",
          "root",
          "exists",
          "issues"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "sourceType": {
            "enum": [
              "path",
              "git"
            ]
          },
          "root": {
            "type": "string"
          },
          "exists": {
            "type": "boolean"
          },
          "branch": {
            "type": "string"
          },
          "commit": {
            "type": "string"
          },
          "dirty": {
            "type": "boolean"
          },
          "remoteUrl": {
            "type": "string"
          },
          "issues": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  }
}
